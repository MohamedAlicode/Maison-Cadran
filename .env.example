# Copier ce fichier en .env puis renseigner les valeurs.
# Ne jamais committer le fichier .env.

# Base PostgreSQL (Neon en production, Postgres local en développement)
DATABASE_URL="postgresql://postgres@localhost:5432/maison_cadran"

# URL publique du site (sans / final), utilisée pour le SEO et les emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Paiement (phase 3) : clés de TEST du tableau de bord Stripe ──
# Sans clé, le site fonctionne mais le bouton « Commander » indique que le paiement est désactivé.
# Le secret du webhook est affiché par `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── E-mails (phase 3) ──
# Sans clé, les e-mails sont écrits dans le dossier .emails/ en développement.
# RESEND_API_KEY="re_..."
# EMAIL_EXPEDITEUR="Maison Cadran <commandes@votre-domaine.fr>"

# ── Phases suivantes (laisser vide pour l'instant) ──
# AUTH_SECRET=""
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
