# Copier ce fichier en .env puis renseigner les valeurs.
# Ne jamais committer le fichier .env.

# Base PostgreSQL (Neon en production, Postgres local en développement)
DATABASE_URL="postgresql://postgres@localhost:5432/maison_cadran"

# URL publique du site (sans / final), utilisée pour le SEO et les emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

