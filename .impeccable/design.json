  "narrative": {
    "northStar": "L'établi de l'horloger",
    "overview": "Un plan de travail en acier, une lumière franche, et la montre posée au centre. Tout le reste s'efface : la page est d'un blanc légèrement grisé, comme un boîtier brossé, et la seule couleur vive est le bleu soleillé des cadrans. Ce bleu ne décore pas : il marque ce qu'on peut faire (acheter, suivre un lien, savoir où est le focus).",
    "keyCharacteristics": [
      "Fond acier, photos sur blanc pur : la montre flotte, sans cadre.",
      "Un seul accent, le bleu cadran, réservé aux actions, aux liens et au focus.",
      "Serif étroit pour nommer, grotesque net pour informer.",
      "Coins quasi droits (2px), filets fins plutôt que des ombres."
    ],
    "rules": [
      {
        "name": "La règle du cadran unique",
        "body": "Le bleu cadran est la seule couleur d'accent. Une deuxième teinte vive n'entre pas sans décision écrite dans ce fichier.",
        "section": "colors"
      },
      {
        "name": "La règle de l'acier teinté",
        "body": "Aucun noir ni gris pur : les neutres tirent toujours vers le bleu (encre, graphite, nuit).",
        "section": "colors"
      },
      {
        "name": "La règle du poids unique",
        "body": "Instrument Serif n'a qu'une graisse : un titre n'est jamais en font-medium ou plus, sous peine de faux gras.",
        "section": "typography"
      },
      {
        "name": "La règle marque, modèle, prix",
        "body": "Sur toute présentation produit, cet ordre et ces trois styles (eyebrow, title ou display, price) ne changent pas.",
        "section": "typography"
      },
      {
        "name": "La règle du verre utile",
        "body": "Le flou d'arrière-plan (16px) sert uniquement à garder lisible un élément collant ou posé sur une photo. Il a toujours un fond assez opaque (85% au moins) pour que le texte garde 4.5:1, et jamais de reflet ni de lueur.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** présenter chaque montre sur blanc pur avec sa marge en pourcentage.",
      "**Do** utiliser le bleu cadran pour tout ce qui est cliquable, et rien d'autre.",
      "**Do** écrire les prix en chiffres tabulaires.",
      "**Do** passer par les tokens de `src/app/globals.css` : aucune couleur, taille ou durée en dur.",
      "**Do** respecter `prefers-reduced-motion` (géré globalement) et garder un focus visible."
    ],
    "donts": [
      "**Don't** utiliser de dégradés violet ou bleu, de lueurs, de glassmorphism décoratif ou d'easing rebondissant.",
      "**Don't** mettre une carte dans une carte.",
      "**Don't** utiliser d'emojis comme icônes : SVG Lucide uniquement.",
      "**Don't** utiliser de noir ou de gris purs.",
      "**Don't** utiliser Inter, Arial ou une police système comme police de marque.",
      "**Don't** afficher de logo officiel de marque ni écrire « garantie constructeur »."
    ]
  }
